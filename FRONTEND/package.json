{
  "name": "chu-ukv-frontend",
  "productName": "CHU UKV Pharmacie",
  "version": "0.2.0",
  "description": "CHU UKV — poste pharmacie Electron + SQLite + sync Symfony",
  "author": "CHU UKV",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.js",
    "build": "vite build",
    "build:electron": "cross-env ELECTRON=1 vite build",
    "build:win": "npm run build:electron && electron-builder --win",
    "build:installer": "npm run build:electron && electron-builder --win nsis",
    "build:portable": "npm run build:electron && electron-builder --win portable",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/joy": "^5.0.0-beta.52",
    "@reduxjs/toolkit": "^2.10.0",
    "dexie": "^4.4.5",
    "lucide-react": "^1.39.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.2",
    "recharts": "^3.10.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^7.0.3",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "cd.chu-ukv.pharmacie-desktop",
    "productName": "CHU UKV Pharmacie",
    "copyright": "Copyright © 2026 CHU UKV",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronDist": "vendor/electron",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/sql.js/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CHU UKV Pharmacie",
      "license": "build/license.txt"
    },
    "portable": {
      "artifactName": "CHU-UKV-Pharmacie-Portable-${version}.exe"
    }
  }
}
